#!/bin/bash
# Before a push: the whole text check, and in a Rust repository every check
# CI would run. A push that would fail there is stopped here instead.
set -uo pipefail
root=$(git rev-parse --show-toplevel)
"$root/scripts/check-text" || exit 1
if [ -f "$root/Cargo.toml" ] && [ -x "$root/scripts/check-rust" ]; then
  "$root/scripts/check-rust" || exit 1
fi
