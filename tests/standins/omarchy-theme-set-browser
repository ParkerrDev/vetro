#!/bin/bash
# Stand-in for Omarchy's command that gives the browsers the theme's colour:
# the theme's chromium.theme, or Omarchy's own default without one.
S=${STANDIN_STATE:?STANDIN_STATE is not set}
mkdir -p "$S"
echo "omarchy-theme-set-browser $*" >>"$S/log"
colour=1c2027
rgb=$(cat "$HOME/.local/state/omarchy/current/theme/chromium.theme" 2>/dev/null || true)
if [[ $rgb =~ ^([0-9]+),([0-9]+),([0-9]+)$ ]]; then
  colour=$(printf '%02x%02x%02x' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}")
fi
omarchy-theme-set-browser-policy "$colour"
